# Copy to .env.test (gitignored) for `npm test`.
#
# Integration tests DELETE EVERY ROW in this database before each test.
# The database name must end in "_test" — the suite refuses to run otherwise.
# It is created automatically (and migrated) on the first run, so the MySQL
# user needs CREATE privileges.
#
# Every other variable (JWT secrets, Stripe, Cloudinary, Redis) is set to a
# dummy value by tests/setup/loadTestEnv.ts; real services are never contacted.
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3307/ecommerce_test"
